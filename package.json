{
  "name": "git-command",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "./lib/main",
  "description": "Run common Git workflows from a searchable select list in Lumine's modal pane zone.",
  "repository": "https://github.com/lumine-code/git-command",
  "bugs": {
    "url": "https://github.com/lumine-code/git-command/issues"
  },
  "keywords": [
    "version-control",
    "vcs",
    "commit",
    "branch",
    "staging",
    "repository",
    "diff",
    "blame"
  ],
  "license": "MIT",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "styles"
  ],
  "engines": {
    "atom": ">=1.132.1 <2.0.0"
  },
  "backgroundTips": [
    "You can open every common Git workflow with {{ 'git-command:menu' | keystroke }}"
  ],
  "activationCommands": {
    "atom-workspace": [
      "git-command:menu",
      "git-command:status",
      "git-command:stage-current-file",
      "git-command:stage-all",
      "git-command:unstage-current-file",
      "git-command:unstage-all",
      "git-command:commit",
      "git-command:stage-all-and-commit",
      "git-command:quick-commit-current-file",
      "git-command:amend",
      "git-command:diff-current-file",
      "git-command:diff-all",
      "git-command:log",
      "git-command:log-current-file",
      "git-command:blame-current-file",
      "git-command:open-changed-files",
      "git-command:restore-current-file",
      "git-command:checkout",
      "git-command:new-branch",
      "git-command:merge",
      "git-command:rebase",
      "git-command:cherry-pick",
      "git-command:fetch",
      "git-command:fetch-all",
      "git-command:pull",
      "git-command:push",
      "git-command:stash",
      "git-command:manage-stashes",
      "git-command:run"
    ]
  },
  "configSchema": {
    "protectedBranches": {
      "title": "Protected branches",
      "description": "Branch names on which guarded commit and push actions are blocked.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "main",
        "master"
      ]
    },
    "protectCommits": {
      "title": "Protect commits",
      "description": "Block commit workflows on protected branches.",
      "type": "boolean",
      "default": true
    },
    "protectPushes": {
      "title": "Protect pushes",
      "description": "Block pushes from protected branches.",
      "type": "boolean",
      "default": true
    },
    "pullRebase": {
      "title": "Rebase when pulling",
      "description": "Pass --rebase to pull operations.",
      "type": "boolean",
      "default": false
    },
    "stashIncludeUntracked": {
      "title": "Stash untracked files",
      "description": "Include untracked files when creating a stash.",
      "type": "boolean",
      "default": true
    },
    "logLimit": {
      "title": "Log entry limit",
      "description": "Maximum number of commits shown by log and cherry-pick workflows.",
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.2.2",
    "globals": "^17.8.0",
    "prettier": "^3.9.6"
  }
}
