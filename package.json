{
  "name": "git-command",
  "author": "lumine-code",
  "version": "1.0.0",
  "main": "./lib/main",
  "files": [
    "keymaps",
    "lib",
    "menus",
    "spec",
    "styles"
  ],
  "description": "Run common Git workflows from a searchable select list in Lumine's modal pane zone.",
  "repository": "https://github.com/lumine-code/git-command",
  "bugs": {
    "url": "https://github.com/lumine-code/git-command/issues"
  },
  "keywords": [
    "version-control",
    "vcs",
    "commit",
    "branch",
    "staging",
    "repository",
    "diff",
    "blame"
  ],
  "license": "MIT",
  "engines": {
    "lumine": "^1.0.0"
  },
  "configSchema": {
    "stashIncludeUntracked": {
      "title": "Stash untracked files",
      "description": "Include untracked files when creating a stash.",
      "type": "boolean",
      "default": true
    },
    "logLimit": {
      "title": "Log entry limit",
      "description": "Maximum number of commits shown by log and cherry-pick workflows.",
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "default": 50
    }
  },
  "scripts": {
    "test": "lumine --test spec",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "providedServices": {
    "background-tips.provider": {
      "versions": {
        "1.0.0": "provideBackgroundTips"
      }
    }
  },
  "consumedServices": {
    "patch-view": {
      "versions": {
        "^1.0.0": "consumePatchView"
      }
    }
  },
  "specPackages": [
    "patch-view"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.4.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.9"
  }
}
